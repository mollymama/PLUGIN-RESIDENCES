    .unit-card {
      --unit-reveal-x: 0px;
      position: relative;
      overflow: hidden;
      min-height: 100svh;
      border: 0;
      border-radius: 0;
      background: #11100e;
      cursor: pointer;
      opacity: 1;
      transform: translateX(var(--unit-reveal-x));
      transition:
        border-color 0.4s ease,
        box-shadow 0.4s ease;
      transition-delay: var(--unit-reveal-delay, 0ms);
    }

    .unit-card.is-scroll-hidden {
      --unit-reveal-x: 0px;
      opacity: 0;
    }

    .unit-card.is-scroll-visible {
      --unit-reveal-x: 0px;
      opacity: 1;
    }

    .unit-card:hover {
      transform: translateX(var(--unit-reveal-x));
      background: #11100e;
      box-shadow: none;
    }

    .unit-card::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(90deg, rgba(0, 0, 0, 0.58), rgba(0, 0, 0, 0.2) 48%, rgba(0, 0, 0, 0.5)),
        linear-gradient(0deg, rgba(0, 0, 0, 0.6), transparent 46%, rgba(0, 0, 0, 0.12));
      pointer-events: none;
    }

    .unit-card::after {
      content: "";
      position: absolute;
      right: 20px;
      bottom: 20px;
      width: 24px;
      height: 24px;
      border-top: 1px solid currentColor;
      border-right: 1px solid currentColor;
      z-index: 3;
      color: #201d18;
      opacity: 0.28;
      transform: translate(-5px, 5px) rotate(45deg);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .unit-card:hover::after,
    .unit-card:focus-visible::after {
      color: #fffaf0;
      opacity: 0.78;
      transform: translate(0, 0) rotate(45deg);
