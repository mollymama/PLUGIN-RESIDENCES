/* style.css */
/* 這會把網頁上每一個 <div> 都加上這些樣式 */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      background: #ffffff;
      color: #87531f;
      overflow-x: hidden;
    }

    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 100;
      padding: 22px 34px;
      display: grid;
      grid-template-columns: minmax(180px, 1fr) auto minmax(110px, 1fr);
      gap: 14px;
      align-items: center;
      background: transparent;
      backdrop-filter: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      transition: transform 0.35s ease, opacity 0.35s ease;
    }

    header:hover {
      background: rgba(250, 245, 232, 0.82);
      backdrop-filter: blur(18px);
      outline: 0;
      box-shadow: none;
    }

    header.header-hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-140%);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      padding-left: 2px;
      min-width: 0;
      color: #fff;
      text-decoration: none;
      transition: color 0.25s ease;
    }

    .brand-logo-frame {
      width: auto;
      height: 52px;
      display: block;
      flex: 0 0 auto;
    }

    .brand-logo {
      width: auto;
      height: 52px;
      display: block;
      transition: filter 0.25s ease, opacity 0.25s ease;
    }

    .brand:hover .brand-logo {
      filter: brightness(0);
    }

    .logo {
      display: block;
      font-size: 21px;
      font-weight: 800;
      letter-spacing: 0;
      line-height: 1.1;
    }

    .brand-subtitle {
      display: block;
      margin-top: 5px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 11px;
      letter-spacing: 1.1px;
      text-transform: uppercase;
      line-height: 1;
    }

    nav {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 4px;
      border-radius: 999px;
      background: transparent;
      border: 0;
    }

    nav a {
      min-width: 106px;
      padding: 13px 18px;
      border-radius: 999px;
      text-align: center;
      text-decoration: none;
      color: #fff;
      font-size: 14px;
      font-weight: 750;
      transition: 0.25s ease;
    }

    nav a:hover {
      background: #cebc98;
      color: #26311f;
      outline: 1px solid rgba(54, 65, 42, 0.16);
      box-shadow: none;
    }

    .header-cta {
      justify-self: end;
      padding: 14px 24px;
      background: rgba(255, 255, 255, 0.88);
      color: #26311f;
      border: 0;
      border-radius: 999px;
      box-shadow: none;
      font-weight: 800;
    }

    header:hover .brand,
    header:hover nav a {
      color: #26311f;
    }

    header:hover .brand-subtitle {
      color: rgba(38, 49, 31, 0.58);
    }

    header:hover .header-cta {
      background: #26311f;
      color: #fffaf0;
    }

    .header-cta:hover {
      background: #dbe8c5;
      color: #26311f;
    }

    .hero {
      min-height: 100vh;
      padding: 72px 56px;
      position: relative;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(90deg, rgba(0, 0, 0, 0.68), rgba(0, 0, 0, 0.18) 52%, rgba(0, 0, 0, 0.36)),
        linear-gradient(0deg, rgba(0, 0, 0, 0.62), transparent 42%);
      pointer-events: none;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 900px;
    }

    .hero h1 {
      font-size: clamp(64px, 8vw, 118px);
      line-height: 0.82;
      letter-spacing: -2px;
      margin-bottom: 34px;
      color: #fff;
      text-transform: uppercase;
    }

    .kinetic-title {
      display: grid;
      gap: 6px;
      width: max-content;
      max-width: 100%;
      perspective: 900px;
      cursor: pointer;
      outline: none;
    }

    .kinetic-title span {
      display: block;
      width: max-content;
      transform-origin: left center;
      transition: transform 0.75s cubic-bezier(0.19, 1, 0.22, 1), color 0.35s ease;
      transform-style: preserve-3d;
    }

    .kinetic-title span:nth-child(2) {
      color: transparent;
      -webkit-text-stroke: 2px #fff;
    }

    .kinetic-title:hover span:nth-child(1) {
      transform: rotateY(-34deg) translateX(18px);
    }

    .kinetic-title:hover span:nth-child(2) {
      transform: rotateY(38deg) translateX(48px);
    }

    .kinetic-title:hover span:nth-child(3) {
      transform: rotateY(-22deg) translateX(10px);
    }

    .kinetic-title:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 10px;
    }

    .hero p {
      width: min(620px, 100%);
      font-size: 18px;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.86);
    }

    .hero-copy {
      width: min(680px, 100%);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      color: #fff;
    }

    .hero-copy::before {
      content: "";
      width: min(180px, 42vw);
      height: 3px;
      background: #fff;
    }

    .hero-copy .hero-statement {
      width: 100%;
      margin: 0;
      color: rgba(255, 255, 255, 0.94);
      font-size: clamp(24px, 2.4vw, 36px);
      font-weight: 700;
      line-height: 1.12;
      letter-spacing: 0;
    }

    .hero-copy .hero-action {
      width: 100%;
      margin: 0;
      color: rgba(255, 255, 255, 0.72);
      font-size: 13px;
      font-weight: 800;
      line-height: 1.5;
      letter-spacing: 1.8px;
      text-transform: uppercase;
    }

    button {
      border: none;
      cursor: pointer;
      padding: 14px 24px;
      border-radius: 999px;
      font-size: 14px;
      transition: 0.3s;
    }

    .primary {
      background: transparent;
      color: #fff;
      border: 3px solid #fff;
    }

    .secondary {
      background: transparent;
      color: #fff;
      border: 3px solid #fff;
    }

    .primary:hover,
    .secondary:hover {
      background: #fff;
      color: #111;
    }

    button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.15);
    }

    .model-box {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 0;
      overflow: hidden;
      border: 0;
      box-shadow: none;
    }

    @keyframes imageReveal {
      from {
        transform: scale(1.08);
      }

      to {
        transform: scale(1);
      }
    }

    .model-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-video {
      position: absolute;
      inset: 0;
    }

    .carousel-track {
      width: 100%;
      height: 100%;
      position: relative;
      z-index: 0;
    }

    .carousel-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.6s ease;
    }

    .carousel-slide.active {
      opacity: 1;
    }

    .carousel-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      width: 44px;
      height: 44px;
      padding: 0;
      border-radius: 50%;
      background: #ffffffbd;
      color: #3a3129;
      border: 1px solid rgba(70,60,50,0.18);
      font-size: 34px;
      line-height: 1;
      display: grid;
      place-items: center;
      box-shadow: 0 12px 28px rgba(40,30,20,0.16);
    }

    .carousel-btn:hover {
      transform: translateY(-50%) scale(1.06);
    }

    .carousel-prev {
      left: 18px;
    }

    .carousel-next {
      right: 18px;
    }

    .carousel-dots {
      position: absolute;
      left: 50%;
      bottom: 28px;
      transform: translateX(-50%);
      z-index: 3;
      display: flex;
      gap: 8px;
    }

    .carousel-dot {
      width: 9px;
      height: 9px;
      padding: 0;
      border-radius: 50%;
      background: rgba(255,255,255,0.64);
      border: 1px solid rgba(70,60,50,0.25);
    }

    .carousel-dot.active {
      width: 26px;
      border-radius: 999px;
      background: #3a3129;
    }

    .building {
      position: absolute;
      width: 260px;
      height: 340px;
      left: 50%;
      top: 52%;
      transform: translate(-50%, -50%) rotateX(58deg) rotateZ(-35deg);
      transform-style: preserve-3d;
    }

    .block {
      position: absolute;
      width: 220px;
      height: 70px;
      background: rgba(80, 68, 56, 0.86);
      border: 1px solid rgba(255,255,255,0.24);
      box-shadow: 0 18px 30px rgba(0,0,0,0.22);
    }

    .b1 { bottom: 0; left: 0; }
    .b2 { bottom: 74px; left: 28px; background: #8b725c; }
    .b3 { bottom: 148px; left: 56px; background: #b0977f; }
    .b4 { bottom: 222px; left: 84px; background: #d3b99e; }

    .label {
      position: absolute;
      left: 32px;
      top: 32px;
      z-index: 3;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255,255,255,0.68);
      font-size: 13px;
      letter-spacing: 1px;
      color: #4b4036;
    }

    section {
      padding: 96px 56px;
    }

    main > section:not(.hero) {
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .section-inner {
      width: 100%;
      margin: 0 auto;
    }

    main > section:not(.hero) > .section-inner,
    .proposal-section {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .section-heading-grid {
      display: grid;
      grid-template-columns: minmax(240px, 0.8fr) minmax(320px, 1.2fr);
      gap: 40px;
      align-items: end;
      margin-bottom: 36px;
    }

    .section-title {
      font-size: 42px;
      margin-bottom: 18px;
    }

    #units .section-heading-grid,
    #about .section-heading-grid,
    #building-system .section-heading-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      align-items: start;
      margin-bottom: 38px;
    }

    #units .section-title,
    #system .location-heading .section-title,
    #about .section-title,
    #building-system .section-title {
      position: relative;
      width: fit-content;
      margin: 0;
      padding-top: 28px;
      color: #2f281f;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(54px, 6vw, 96px);
      font-weight: 400;
      line-height: 0.92;
      letter-spacing: -0.055em;
    }

    #system .location-heading .section-title,
    #about .section-title,
    #building-system .section-title {
      color: #2f281f;
      font-family: Georgia, "Times New Roman", serif;
      font-weight: 400;
    }

    #units .section-title::before,
    #system .location-heading .section-title::before,
    #about .section-title::before,
    #building-system .section-title::before {
      position: absolute;
      left: 4px;
      top: 0;
      color: #b07642;
      font-family: "Helvetica Neue", Arial, sans-serif;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2.4px;
      line-height: 1;
      text-transform: uppercase;
    }

    #system .location-heading .section-title::before,
    #about .section-title::before,
    #building-system .section-title::before {
      color: #b07642;
      font-family: "Helvetica Neue", Arial, sans-serif;
      font-weight: 800;
    }

    #units .section-title::before {
      content: "Curated Residences";
    }

    #system .location-heading .section-title::before {
      content: "Greater Taipei Network";
    }

    #about .section-title::before {
      content: "Selected Base Layer";
    }

    #building-system .section-title::before {
      content: "Modular Architecture";
    }

    #units .section-title::after,
    #system .location-heading .section-title::after,
    #about .section-title::after,
    #building-system .section-title::after {
      content: "";
      position: absolute;
      left: calc(100% + 22px);
      bottom: 0.16em;
      width: min(26vw, 280px);
      height: 1px;
      background: linear-gradient(90deg, rgba(176, 118, 66, 0.72), rgba(176, 118, 66, 0));
    }

    #units .section-desc {
      display: none;
    }

    .section-desc {
      color: #665b50;
      line-height: 1.8;
      max-width: 720px;
      margin-bottom: 48px;
    }

    .section-heading-grid .section-title,
    .section-heading-grid .section-desc {
      margin-bottom: 0;
    }

    .section-kicker {
      margin-bottom: 10px;
      color: #8a7058;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }

    .building-system-section {
      padding: 96px 0;
      background: #f2f1ee;
      border: 0;
    }

    .building-system-section .section-inner {
      width: 100%;
    }

    .building-system-section .section-heading-grid {
      padding: 0 clamp(24px, 6.4vw, 132px);
      margin-bottom: 0;
    }

    .building-system-section .section-desc {
      color: rgba(29, 29, 27, 0.62);
    }

    .building-system-gallery-wrap {
      min-width: 0;
      overflow: hidden;
      margin-top: clamp(30px, 4vw, 56px);
    }

    .building-system-diagram {
      display: flex;
      gap: clamp(14px, 1.3vw, 24px);
      align-items: stretch;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-behavior: smooth;
      scroll-padding-inline: clamp(24px, 6.4vw, 132px);
      scroll-snap-type: x mandatory;
      padding: 0 clamp(24px, 6.4vw, 132px) 8px;
      margin-top: clamp(28px, 4vw, 56px);
      cursor: grab;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .building-system-diagram::-webkit-scrollbar {
      display: none;
    }

    .building-system-card {
      position: relative;
      flex: 0 0 min(56vw, 920px);
      height: min(74svh, 800px);
      min-height: 480px;
      overflow: visible;
      margin: 0;
      border: 0;
      border-radius: 0;
      background: #ffffff;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .building-system-card-large {
      flex-basis: min(64vw, 980px);
    }

    .building-system-card:nth-child(6),
    .building-system-card:nth-child(7) {
      flex-basis: min(86vw, 1480px);
    }

    .building-system-card:nth-child(7) {
      flex-basis: min(96vw, 1780px);
    }

    .building-system-card img {
      position: absolute;
      left: 50%;
      top: 50%;
      width: min(36%, 430px);
      height: min(80%, 760px);
      display: block;
      object-fit: contain;
      margin: auto;
      transform: translate(-50%, -50%);
      user-select: none;
      -webkit-user-drag: none;
      pointer-events: none;
    }

    .building-system-card:nth-child(5) img,
    .building-system-card:nth-child(6) img,
    .building-system-card:nth-child(7) img {
      width: auto;
      height: min(80%, 760px);
    }

    .building-system-card figcaption {
      display: none;
    }

    .building-system-card figcaption span {
      color: rgba(28, 28, 24, 0.36);
    }

    .building-system-card::after {
      content: none;
    }

    .building-system-controls {
      justify-self: end;
      padding: 0;
    }

    .building-system-footer {
      margin-top: clamp(28px, 3.6vw, 48px);
    }

    .architecture-intro-section {
      min-height: 100svh;
      padding: clamp(70px, 7vw, 104px) 0 clamp(36px, 5vw, 64px);
      background: #f2f1ee;
      color: #1d1d1b;
      overflow: visible;
    }

    .architecture-intro-shell {
      width: 100%;
      display: grid;
      grid-template-rows: auto auto auto auto;
      gap: clamp(18px, 2.4vw, 32px);
    }

    .architecture-intro-heading {
      display: block;
      padding: 0 clamp(24px, 6.4vw, 132px);
    }

    .architecture-intro-heading p {
      margin: 0 0 17px 4px;
      color: #b07642;
      font-family: "Helvetica Neue", Arial, sans-serif;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2.4px;
      line-height: 1;
      text-transform: uppercase;
    }

    .architecture-intro-heading h2 {
      position: relative;
      width: fit-content;
      margin: 0;
      color: #2f281f;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(54px, 6vw, 96px);
      font-weight: 400;
      line-height: 0.92;
      letter-spacing: -0.055em;
    }

    .architecture-intro-heading h2::after {
      content: "";
      position: absolute;
      left: calc(100% + 22px);
      bottom: 0.16em;
      width: min(26vw, 280px);
      height: 1px;
      background: linear-gradient(90deg, rgba(176, 118, 66, 0.72), rgba(176, 118, 66, 0));
    }

    .architecture-building-system-heading {
      margin-top: clamp(72px, 10vw, 148px);
    }

    .architecture-gallery-wrap.architecture-system-gallery-wrap {
      margin-top: clamp(24px, 3vw, 40px);
    }

    #architecture-system-gallery .architecture-slide {
      position: relative;
      flex-basis: min(56vw, 920px);
      overflow: visible;
      background: #ffffff;
    }

    #architecture-system-gallery .architecture-system-slide-large {
      flex-basis: min(64vw, 980px);
    }

    #architecture-system-gallery .architecture-slide:nth-child(6),
    #architecture-system-gallery .architecture-slide:nth-child(7) {
      flex-basis: min(86vw, 1480px);
    }

    #architecture-system-gallery .architecture-slide:nth-child(7) {
      flex-basis: min(96vw, 1780px);
    }

    #architecture-system-gallery .architecture-slide img {
      position: absolute;
      left: 50%;
      top: 50%;
      width: min(36%, 430px);
      height: min(80%, 760px);
      object-fit: contain;
      transform: translate(-50%, -50%);
    }

    #architecture-system-gallery .architecture-slide:nth-child(5) img,
    #architecture-system-gallery .architecture-slide:nth-child(6) img,
    #architecture-system-gallery .architecture-slide:nth-child(7) img {
      width: auto;
      height: min(80%, 760px);
    }

    .architecture-feature-image {
      width: min(52vw, 980px);
      height: clamp(560px, 48vw, 760px);
      min-height: 0;
      margin: clamp(36px, 5vw, 72px) auto 0 clamp(24px, 6.4vw, 132px);
      display: grid;
      place-items: center;
      overflow: hidden;
      background: #f4f3ef;
    }

    .architecture-section-showcase {
      width: 100%;
      margin-top: clamp(36px, 5vw, 72px);
      padding: 0 clamp(24px, 6.4vw, 132px);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      align-items: stretch;
      gap: clamp(28px, 4vw, 56px);
    }

    .architecture-section-showcase .architecture-feature-image {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 100%;
      height: clamp(560px, 48vw, 760px);
      margin: 0;
    }

    .public-space-gallery-panel {
      position: relative;
      z-index: 3;
      min-width: 0;
      margin-left: 0;
      transform: translateX(clamp(-64px, -4vw, -28px));
      display: grid;
      grid-template-rows: auto auto;
      gap: clamp(14px, 1.6vw, 22px);
    }

    .public-space-gallery {
      width: 100%;
      min-width: 0;
      height: clamp(560px, 48vw, 760px);
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      cursor: grab;
      background: #ddd9d2;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .public-space-gallery::-webkit-scrollbar {
      display: none;
    }

    .public-space-gallery.is-dragging {
      cursor: grabbing;
      scroll-behavior: auto;
      scroll-snap-type: none;
    }

    .public-space-slide {
      flex: 0 0 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: #ddd9d2;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .public-space-slide img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center center;
      user-select: none;
      -webkit-user-drag: none;
      pointer-events: none;
    }

    .public-space-footer {
      width: 100%;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(12px, 1.6vw, 22px);
    }

    .public-space-count {
      min-width: 160px;
      font-weight: 700;
      letter-spacing: 0;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .public-space-count span[aria-hidden="true"] {
      opacity: 0.42;
    }

    .public-space-kicker,
    .public-space-copy {
      margin: 0;
    }

    .public-space-kicker {
      color: rgba(29, 29, 27, 0.58);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .public-space-copy {
      margin-top: 6px;
      color: rgba(29, 29, 27, 0.72);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.45;
    }

    .public-space-controls {
      justify-self: end;
      gap: 8px;
    }

    .public-space-controls .architecture-control {
      border-color: rgba(29, 29, 27, 0.52);
    }

    .architecture-section-reveal {
      --section-reveal: 0%;
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      cursor: ew-resize;
      touch-action: none;
      outline: none;
      isolation: isolate;
    }

    .architecture-section-reveal:focus-visible {
      box-shadow: 0 0 0 2px #1d1d1b, 0 0 0 6px rgba(29, 29, 27, 0.12);
    }

    .architecture-feature-image img {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      display: block;
      object-fit: contain;
      object-position: center center;
      user-select: none;
      -webkit-user-drag: none;
    }

    .architecture-section-reveal-base {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center center;
      clip-path: inset(0 0 0 var(--section-reveal));
    }

    .architecture-section-reveal-cut {
      position: absolute;
      inset: 0;
      z-index: 1;
      clip-path: inset(0 calc(100% - var(--section-reveal)) 0 0);
      pointer-events: none;
    }

    .architecture-section-reveal-cut img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: contain;
      object-position: center center;
      transform: translateX(-0.2%);
    }

    .architecture-section-reveal-handle {
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--section-reveal);
      z-index: 2;
      width: 0;
      pointer-events: none;
    }

    .architecture-section-reveal-handle::before {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 1px;
      height: min(32%, 220px);
      background: rgba(0, 0, 0, 0.25);
      transform: translate(-50%, -50%);
    }

    .architecture-section-reveal-handle span {
      position: absolute;
      top: 50%;
      left: 0;
      width: 46px;
      height: 46px;
      border: 0;
      border-radius: 999px;
      background: #ffffff;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      transform: translate(-50%, -50%);
    }

    .architecture-section-reveal-handle span::before {
      content: "\2194";
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: rgba(29, 29, 27, 0.72);
      font-family: "Helvetica Neue", Arial, sans-serif;
      font-size: 19px;
      font-weight: 500;
      line-height: 1;
    }

    .architecture-section-reveal-handle span::after {
      content: none;
    }

    .architecture-section-markers {
      position: absolute;
      inset: 0;
      z-index: 4;
      pointer-events: none;
    }

    .architecture-section-marker {
      position: absolute;
      left: var(--marker-left);
      top: var(--marker-top);
      pointer-events: auto;
      width: clamp(34px, 2.6vw, 42px);
      height: clamp(34px, 2.6vw, 42px);
      display: grid;
      place-items: center;
      border: 1px solid rgba(17, 17, 17, 0.72);
      border-radius: 999px;
      background: rgba(250, 247, 239, 0.94);
      color: #111111;
      font-family: "Helvetica Neue", Arial, sans-serif;
      font-size: clamp(15px, 1.15vw, 18px);
      font-weight: 700;
      line-height: 1;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.13);
      transform: translate(-50%, -50%);
      transition: color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
      cursor: pointer;
    }

    .architecture-section-marker:hover {
      transform: translate(-50%, -50%) scale(1.06);
    }

    /* Section marker positions */
    .architecture-section-marker[data-public-space-marker="1"] {
      --marker-left: 45%;
      --marker-top: 72%;
    }

    .architecture-section-marker[data-public-space-marker="2"] {
      --marker-left: 65%;
      --marker-top: 69%;
    }

    .architecture-section-marker[data-public-space-marker="3"] {
      --marker-left: 58%;
      --marker-top: 38%;
    }

    .architecture-section-marker.is-active {
      background: #111111;
      color: #ffffff;
      box-shadow:
        0 0 0 7px rgba(244, 239, 226, 0.46),
        0 10px 28px rgba(0, 0, 0, 0.18);
      transform: translate(-50%, -50%) scale(1.08);
