    .unit-modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: grid;
      place-items: center;
      padding: 0;
      background: rgba(255, 255, 255, 0.68);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.24s ease, visibility 0.24s ease;
    }

    .unit-modal.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .unit-modal-backdrop {
      position: absolute;
      inset: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .unit-modal-window {
      position: relative;
      width: min(99vw, 1960px);
      height: min(94vh, 1120px);
      overflow: hidden;
      border-radius: 6px;
      background: #e6ded1;
      box-shadow: 0 24px 80px rgba(17, 17, 17, 0.18);
      transform: translateY(10px);
      transition: transform 0.24s ease;
    }

    .unit-modal.is-open .unit-modal-window {
      transform: translateY(0);
    }

    .unit-modal-close {
      position: absolute;
      top: 18px;
      right: 18px;
      z-index: 4;
      width: 48px;
      height: 48px;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.96);
      color: #111;
      font-size: 34px;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 10px 26px rgba(17, 17, 17, 0.16);
    }

    .unit-modal-frame {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      border: 0;
      border-radius: inherit;
      opacity: 0;
      background: transparent;
      transition: opacity 0.28s ease;
    }

    .unit-modal-frame.is-loaded {
      opacity: 1;
    }

    .unit-modal-loader {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: grid;
      place-items: center;
      gap: 16px;
      align-content: center;
      border-radius: inherit;
      background: #e6ded1;
      color: #3a3129;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 1.3px;
      text-transform: uppercase;
      transition: opacity 0.22s ease, visibility 0.22s ease;
    }

    .unit-modal-loader span {
      position: relative;
      width: 44px;
      height: 44px;
      border: 3px solid rgba(58, 49, 41, 0.18);
      background: rgba(255, 255, 255, 0.34);
    }

    .unit-modal-loader span::before {
      position: absolute;
      width: 12px;
      height: 12px;
      background: #3a3129;
      content: "";
      animation: modal-loader-run 1.15s infinite ease-in-out;
    }

    .unit-modal-loader.is-hidden {
      opacity: 0;
      visibility: hidden;
    }

    @keyframes modal-loader-run {
      0% {
        left: 3px;
        top: 3px;
      }

      25% {
        left: 23px;
        top: 3px;
      }

      50% {
        left: 23px;
        top: 23px;
      }

      75% {
        left: 3px;
        top: 23px;
      }

      100% {
        left: 3px;
        top: 3px;
      }
    }

    @media (max-width: 820px) {
      .unit-modal {
        padding: 0;
