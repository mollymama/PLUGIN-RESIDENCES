      font-size: clamp(20px, 2.15vw, 34px);
    }

    .architecture-model-step strong {
      font-size: 12px;
    }

    .card h3 {
      font-size: clamp(24px, 2.2vw, 38px);
    }

    #units .card h3 {
      font-size: clamp(62px, 7.7vw, 134px);
    }

    .unit-description {
      font-size: clamp(25px, 2.2vw, 38px);
    }

    .location-intel-hero h3 {
      font-size: clamp(29px, 4.5vw, 61px);
    }

    @media (max-width: 900px) {
      .logo {
        font-size: 17px;
      }

      .hero h1 {
        font-size: clamp(42px, 13.5vw, 66px);
      }

      .hero-copy .hero-statement {
        font-size: 22px;
      }

      #units .section-title,
      #system .location-heading .section-title,
      #about .section-title,
      #building-system .section-title,
      .architecture-intro-heading h2 {
        font-size: clamp(40px, 12.5vw, 58px);
      }

      .architecture-page-count {
        font-size: 38px;
      }

      .architecture-control {
        font-size: 29px;
      }

      #units .card h3 {
        font-size: clamp(48px, 14.5vw, 94px);
      }
    }

    @media (max-width: 560px) {
      #units .section-title {
        font-size: 34px;
      }

      #units .card h3 {
        font-size: clamp(40px, 14.5vw, 68px);
      }

      #units .unit-description {
        font-size: clamp(16px, 4.9vw, 24px);
      }
